FROM node:20-slim

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

# Copy package metadata and install runtime deps (playwright-chromium)
COPY package*.json ./
RUN npm install --production && npm cache clean --force || true

# Install system libraries required by Chromium
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      fonts-noto \
      fonts-noto-cjk \
      fonts-liberation \
      libnss3 \
      libnspr4 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libxkbcommon0 \
      libasound2 \
      libx11-6 \
      libxcomposite1 \
      libxdamage1 \
      libxrandr2 \
      libgbm1 \
      libpangocairo-1.0-0 \
      libxfixes3 \
      libxrender1 \
      libxss1 \
      libxext6 \
      libxi6 \
      libxcb1 \
      libdbus-1-3 \
      libgconf-2-4 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/*

# Copy test runner and tests
COPY tests/ ./tests/

# Download Chromium only
RUN npx playwright install chromium && \
    rm -rf /ms-playwright/firefox /ms-playwright/webkit || true && \
    rm -rf /tmp/* /var/tmp/*

CMD ["node","ci_run_tests.js"]
